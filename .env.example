# Variables de entorno — NUNCA subir claves reales al repositorio
# Copia este archivo como .env.local y rellena tus claves reales

# Clave primaria (se usa siempre primero)
GEMINI_API_KEY=tu_clave_primaria_de_google_ai_studio

# Clave secundaria de respaldo (solo se activa automáticamente si la primaria devuelve 429 cuota agotada)
GEMINI_API_KEY_SECONDARY=tu_clave_secundaria_de_respaldo
